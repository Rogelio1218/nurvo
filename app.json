{
  "expo": {
    "name": "Nurvo",
    "slug": "nurvo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A6B5A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nurvo.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Nurvo uses the camera to scan medication barcodes.",
        "NSPhotoLibraryUsageDescription": "Nurvo accesses photos to let you add profile pictures.",
        "NSLocationWhenInUseUsageDescription": "Nurvo uses your location to find the nearest pharmacies and best medication prices near you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A6B5A"
      },
      "package": "com.nurvo.app",
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Nurvo to access your camera to scan medication barcodes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nurvo uses your location to find nearby pharmacies with the best prices."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1A6B5A"
        }
      ]
    ],
    "scheme": "nurvo",
    "experiments": {
      "typedRoutes": true
    }
  }
}
